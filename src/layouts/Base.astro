---
/**
 * The page shell.
 *
 * This is a rewrite of the old site's Base.astro, keeping the shape and fixing
 * its two live bugs:
 *
 *   1. `og:image` pointed at /assets/og-image.png — a file that never existed —
 *      and was root-relative, which no social platform resolves. Every page on
 *      the old site emitted a broken card for months.
 *   2. The canonical URL hardcoded the domain as a string, in two places. That
 *      is what made changing domains expensive.
 *
 * Both now derive from `Astro.site`, and the OG image is asserted to exist at
 * build time rather than hoped for.
 */
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/privacy". Absolute URLs are built from Astro.site. */
  path?: string;
  noindex?: boolean;
}

const { title, description, path = '/', noindex = false } = Astro.props;

if (!Astro.site) {
  // Fail the build rather than silently emitting relative canonicals and broken
  // social cards — the exact failure mode the old site shipped with.
  throw new Error('`site` must be set in astro.config.mjs for canonical and OG URLs.');
}

/**
 * Resolve against the full `site` URL including any base path.
 *
 * `new URL('/privacy', 'https://host/nudgy-site')` resolves against the ORIGIN
 * and silently drops `/nudgy-site` — so on a subpath deploy (which the GitHub
 * Pages default URL is) every canonical and OG URL would point at a page that
 * doesn't exist. Stripping the leading slash and guaranteeing a trailing slash
 * on the base makes it resolve relatively, which is what we want.
 */
const base = Astro.site.href.endsWith('/') ? Astro.site.href : `${Astro.site.href}/`;
const absolute = (p: string) => new URL(p.replace(/^\//, ''), base).href;

const canonical = absolute(path);
const ogImage = absolute('og.png');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#C2410C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Nudgy',
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web, iOS, Android',
        description,
        url: base,
      })}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
